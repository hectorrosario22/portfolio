---
import { Icon } from "astro-icon/components";
import type { Lang } from "../i18n/ui";
import { useTranslations, otherLang, localizedPath } from "../i18n/utils";
import MobileMenu from "./islands/MobileMenu.svelte";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alt = otherLang(lang);

const navItems = [
  { href: "#home", label: t("nav.home") },
  { href: "#about", label: t("nav.about") },
  { href: "#experience", label: t("nav.experience") },
  { href: "#skills", label: t("nav.skills") },
  { href: "#projects", label: t("nav.projects") },
];

const otherLangHref = localizedPath(alt);
---

<nav
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 bg-surface/90 backdrop-blur-sm border-b border-wireframe transition-all duration-300"
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center">
        <a
          href="#home"
          class="text-xl font-display font-bold text-white tracking-wider flex items-center gap-2"
        >
          <span class="text-accent">~/</span>HR
        </a>
      </div>

      <div class="hidden lg:flex items-center space-x-8">
        {
          navItems.map((item) => (
            <a href={item.href} class="nav-link font-mono text-xs uppercase tracking-widest text-secondary-400 hover:text-accent transition-colors duration-300 relative group">
              <span class="opacity-0 group-hover:opacity-100 text-accent absolute -left-3 transition-opacity">_</span>
              {item.label}
            </a>
          ))
        }

        <div class="h-4 w-px bg-wireframe"></div>

        <a
          href={otherLangHref}
          aria-label={t("aria.toggleLanguage")}
          class="flex items-center space-x-2 px-3 py-1.5 rounded-none border border-wireframe text-secondary-400 hover:text-accent hover:border-accent transition-all duration-300"
        >
          <Icon name="fa6-solid:globe" class="w-3 h-3" />
          <span class="font-mono text-xs uppercase">{alt}</span>
        </a>
      </div>

      <div class="lg:hidden">
        <MobileMenu
          client:load
          items={navItems}
          ariaLabel={t("aria.toggleMenu")}
          languageLabel={t("aria.toggleLanguage")}
          otherLangHref={otherLangHref}
          otherLangLabel={alt.toUpperCase()}
          themeAriaLabel={t("aria.toggleDarkMode")}
        />
      </div>
    </div>
  </div>
</nav>

<script>
  // Simplified scroll handler for Industrial Tech
  const nav = document.getElementById("site-nav");
  if (nav) {
    const onScroll = () => {
      // Logic could animate border color if needed
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
