---
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const skillsEntry = await getEntry("skills", lang);
if (!skillsEntry) throw new Error(`Missing skills data for ${lang}`);
const categories = skillsEntry.data.categories;
---

<section id="skills" class="section relative overflow-hidden">
  <div class="absolute inset-0 opacity-5 pointer-events-none">
    <div class="absolute top-20 left-20 w-64 h-64 bg-primary-200 rounded-full mix-blend-multiply filter blur-xl"></div>
    <div class="absolute bottom-20 right-20 w-64 h-64 bg-purple-200 rounded-full mix-blend-multiply filter blur-xl"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="section-title">{t("skills.title")}</h2>
    <p class="section-subtitle">{t("skills.subtitle")}</p>

    <div class="skills-grid">
      {
        categories.map((category) => (
          <div class="skill-card group">
            <div class="flex items-center mb-6">
              <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center mr-4 shadow-lg">
                <Icon name={category.icon} class="text-white w-6 h-6" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-secondary-900 dark:text-white mb-1">
                  {category.name}
                </h3>
                <div class="w-10 h-0.5 bg-gradient-to-r from-primary-500 to-primary-400 rounded-full" />
              </div>
            </div>

            <div class="grid grid-cols-1 gap-3">
              {category.skills.map((skill) => (
                <div class="flex items-center p-3 bg-white/50 dark:bg-secondary-800/50 rounded-lg hover:bg-white/80 dark:hover:bg-secondary-700/80 transition-all duration-300 border border-secondary-200/50 dark:border-secondary-700/50">
                  <div class="w-8 h-8 bg-primary-100 dark:bg-primary-900/30 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                    <Icon name={skill.icon} class="text-primary-600 dark:text-primary-400 w-4 h-4" />
                  </div>
                  <span class="font-medium text-secondary-800 dark:text-secondary-200 text-sm">
                    {skill.name}
                  </span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <div class="inline-flex items-center space-x-2 bg-white/80 dark:bg-secondary-800/80 backdrop-blur-sm rounded-full px-6 py-3 shadow-lg border border-secondary-200/50 dark:border-secondary-700/50">
        <Icon name="fa6-solid:lightbulb" class="text-primary-500 w-5 h-5" />
        <span class="text-secondary-700 dark:text-secondary-300 font-medium text-sm">
          {t("skills.subtitle")}
        </span>
      </div>
    </div>
  </div>
</section>
