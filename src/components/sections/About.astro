---
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const personal = await getEntry("personal", lang);
if (!personal) throw new Error(`Missing personal entry for ${lang}`);
const p = personal.data;
---

<section id="about" class="py-24 border-b border-wireframe relative bg-[#0c0c0e]">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 flex items-baseline gap-4 border-b border-wireframe pb-4">
      <h2 class="font-display font-bold text-4xl text-white uppercase tracking-wider">01. {t("about.title")}</h2>
      <p class="font-mono text-sm text-secondary-500 hidden sm:block">// {t("about.subtitle")}</p>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-start">
      
      <!-- Image / Identity Card -->
      <div class="lg:col-span-4 border border-wireframe p-4 bg-surface relative group">
        <div class="absolute top-0 right-0 w-3 h-3 bg-accent"></div>
        <div class="border border-wireframe overflow-hidden mb-4 grayscale group-hover:grayscale-0 transition-all duration-700">
          <img
            src="/images/about/me.webp"
            alt={`Portrait of ${p.name}, ${p.title}`}
            loading="lazy"
            class="w-full h-auto object-cover"
          />
        </div>
        <div class="font-mono text-xs space-y-2 text-secondary-400">
          <div class="flex justify-between border-b border-wireframe pb-1">
            <span class="text-secondary-600">ID:</span>
            <span class="text-white">{p.name.toUpperCase()}</span>
          </div>
          <div class="flex justify-between border-b border-wireframe pb-1">
            <span class="text-secondary-600">ROLE:</span>
            <span class="text-white">{p.title.toUpperCase()}</span>
          </div>
          <div class="flex justify-between border-b border-wireframe pb-1">
            <span class="text-secondary-600">STATUS:</span>
            <span class="text-accent flex items-center gap-1"><span class="w-1.5 h-1.5 bg-accent rounded-full animate-pulse"></span> ACTIVE</span>
          </div>
        </div>
      </div>

      <!-- Bio and Data Matrix -->
      <div class="lg:col-span-8">
        <h3 class="font-mono text-accent text-sm uppercase tracking-widest mb-4">
          > {t("about.whoAmI")}
        </h3>
        
        <div class="font-mono text-sm leading-relaxed text-secondary-400 mb-12 space-y-4 border-l-2 border-wireframe pl-4">
          <p>{p.bio.long}</p>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 mb-12 font-mono text-sm">
          {
            [
              { icon: "fa6-solid:envelope", label: "EMAIL", value: p.email },
              { icon: "fa6-solid:globe", label: "LOCATION", value: p.location },
              { icon: "fa6-solid:graduation-cap", label: "EDUCATION", value: p.education },
              { icon: "fa6-solid:briefcase", label: "EXPERIENCE", value: p.experience },
            ].map((info) => (
              <div class="border border-wireframe p-4 hover:border-secondary-500 transition-colors bg-surface-light/50 flex items-start gap-4">
                <Icon name={info.icon} class="text-secondary-600 w-5 h-5 mt-0.5" />
                <div>
                  <p class="text-secondary-600 text-[10px] tracking-widest mb-1">{info.label}</p>
                  <p class="text-white tracking-wide">{info.value}</p>
                </div>
              </div>
            ))
          }
        </div>


      </div>
    </div>
  </div>
</section>
