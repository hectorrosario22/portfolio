---
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import TypedTitle from "../islands/TypedTitle.svelte";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const personal = await getEntry("personal", lang);
if (!personal) throw new Error(`Missing personal entry for ${lang}`);
const { name, bio, social, email } = personal.data;

const titles = [t("hero.title1"), t("hero.title2"), t("hero.title3")];
---

<section id="home" class="min-h-screen flex items-center relative overflow-hidden hero-gradient">
  <div class="absolute inset-0 opacity-5 pointer-events-none">
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary-300 rounded-full mix-blend-multiply filter blur-xl animate-pulse"></div>
    <div class="absolute top-40 right-10 w-72 h-72 bg-purple-300 rounded-full mix-blend-multiply filter blur-xl animate-pulse" style="animation-delay: 2s"></div>
    <div class="absolute -bottom-8 left-20 w-72 h-72 bg-pink-300 rounded-full mix-blend-multiply filter blur-xl animate-pulse" style="animation-delay: 4s"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-20 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-primary-600 font-semibold text-lg md:text-xl mb-6 animate-fade-in">
        {t("hero.greeting")}
      </p>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-secondary-900 dark:text-white mb-6 animate-slide-up">
        {name}
      </h1>

      <div class="text-2xl md:text-4xl lg:text-5xl text-secondary-700 dark:text-secondary-200 font-semibold mb-8 h-16 md:h-20 flex items-center justify-center">
        <TypedTitle client:visible titles={titles} />
      </div>

      <p class="text-lg md:text-xl text-secondary-600 dark:text-secondary-300 mb-12 max-w-3xl mx-auto leading-relaxed animate-slide-up" style="animation-delay: 0.2s">
        {bio.short}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center animate-slide-up" style="animation-delay: 0.4s">
        <a href="#projects" class="btn btn-primary text-lg px-8 py-4">
          {t("projects.title")}
          <Icon name="fa6-solid:arrow-right" class="ml-2 w-4 h-4" />
        </a>
        <a href="#about" class="btn btn-outline text-lg px-8 py-4">
          {t("about.title")}
          <Icon name="fa6-solid:user" class="ml-2 w-4 h-4" />
        </a>
      </div>

      <div class="flex justify-center space-x-6 mt-12 animate-fade-in" style="animation-delay: 0.6s">
        <a href={social.github} target="_blank" rel="noopener noreferrer" class="text-secondary-600 dark:text-secondary-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300" aria-label="GitHub">
          <Icon name="fa6-brands:github" class="w-7 h-7" />
        </a>
        <a href={social.linkedin} target="_blank" rel="noopener noreferrer" class="text-secondary-600 dark:text-secondary-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300" aria-label="LinkedIn">
          <Icon name="fa6-brands:linkedin" class="w-7 h-7" />
        </a>
        <a href={`mailto:${email}`} class="text-secondary-600 dark:text-secondary-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300" aria-label="Email">
          <Icon name="fa6-solid:envelope" class="w-7 h-7" />
        </a>
      </div>
    </div>
  </div>

  <div class="absolute bottom-10 left-0 right-0 flex justify-center animate-bounce">
    <a href="#about" class="text-secondary-400 dark:text-secondary-500 hover:text-primary-500 transition-colors duration-300" aria-label="Scroll to about">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </a>
  </div>
</section>
