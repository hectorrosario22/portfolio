---
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";
import TypedTitle from "../islands/TypedTitle.svelte";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const personal = await getEntry("personal", lang);
if (!personal) throw new Error(`Missing personal entry for ${lang}`);
const { name, bio } = personal.data;

const titles = [t("hero.title1"), t("hero.title2"), t("hero.title3")];
---

<section id="home" class="min-h-screen pt-32 pb-16 flex items-center relative overflow-hidden border-b border-wireframe">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left text side -->
      <div class="lg:col-span-7">
        <div class="inline-block border border-wireframe bg-surface-light/50 px-4 py-1.5 mb-8">
          <p class="font-mono text-xs uppercase tracking-widest text-accent flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            SYS_ONLINE // {t("hero.greeting")}
          </p>
        </div>

        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-6 uppercase tracking-tighter leading-none">
          {name}
        </h1>

        <div class="h-12 md:h-16 mb-6">
          <div class="font-mono text-xl md:text-3xl text-secondary-400">
            > <TypedTitle client:visible titles={titles} />
            <span class="animate-pulse text-accent">_</span>
          </div>
        </div>

        <p class="font-mono text-sm md:text-base text-secondary-500 mb-10 max-w-2xl leading-relaxed border-l-2 border-wireframe pl-4">
          // {bio.short}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 font-mono text-sm uppercase tracking-widest">
          <a href="#projects" class="px-8 py-4 border-2 border-accent bg-accent/10 text-accent hover:bg-accent hover:text-surface transition-all flex items-center justify-center gap-3">
            {t("projects.title")}
            <Icon name="fa6-solid:code" class="w-4 h-4" />
          </a>
          <a href="#about" class="px-8 py-4 border border-wireframe text-secondary-400 hover:text-white hover:border-secondary-500 transition-all flex items-center justify-center gap-3">
            {t("about.title")}
            <Icon name="fa6-solid:user" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Right Code / Architecture side -->
      <div class="lg:col-span-5 hidden md:block">
        <div class="border border-wireframe bg-[#09090b] relative overflow-hidden group">
          <div class="border-b border-wireframe bg-[#121214] px-4 py-2 flex items-center gap-2">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500/50"></div>
            <p class="font-mono text-[10px] text-secondary-600 ml-4">root@sys-architect:~</p>
          </div>
          <div class="p-6 font-mono text-xs leading-loose text-secondary-500">
            <p class="text-accent">guest@portfolio ~ %</p>
            <p class="text-white mt-1 mb-4">./execute_architecture.sh</p>
            <div class="text-secondary-600">
              <p>[INIT] Loading Microservices Container...</p>
              <p>[INFO] Connecting to Message Broker...</p>
              <p>[OK]   gRPC Channels Established</p>
              <p>[WARN] Rate limits nearing threshold</p>
              <p>[INFO] Auto-scaling groups instantiated</p>
            </div>
            <div class="mt-6 flex flex-wrap gap-2 text-[10px]">
              <span class="border border-wireframe px-2 py-1 text-white hover:border-accent transition-colors">.NET Core</span>
              <span class="border border-wireframe px-2 py-1 text-white hover:border-accent transition-colors">Docker</span>
              <span class="border border-wireframe px-2 py-1 text-white hover:border-accent transition-colors">AWS</span>
              <span class="border border-wireframe px-2 py-1 text-accent border-accent">Kubernetes</span>
            </div>
            <p class="text-accent mt-6">guest@portfolio ~ % <span class="animate-pulse">_</span></p>
          </div>
          
          <div class="absolute bottom-0 right-0 w-16 h-16 border-t border-l border-wireframe flex items-center justify-center bg-surface-light">
            <Icon name="fa6-solid:gear" class="w-6 h-6 text-secondary-600 group-hover:text-accent transition-colors" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
