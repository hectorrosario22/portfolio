---
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";
import type { Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projectsEntry = await getEntry("projects", lang);
if (!projectsEntry) throw new Error(`Missing projects data for ${lang}`);
const { items } = projectsEntry.data;
---

<section id="projects" class="py-24 border-b border-wireframe relative bg-[#0c0c0e]">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16 flex items-baseline gap-4 border-b border-wireframe pb-4">
      <h2 class="font-display font-bold text-4xl text-white uppercase tracking-wider">04. {t("projects.title")}</h2>
      <p class="font-mono text-sm text-secondary-500 hidden sm:block">// {t("projects.subtitle")}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      {
        items.map((project, index) => (
          <div class="border border-wireframe bg-surface group relative overflow-hidden">
            <div class="absolute top-0 right-0 text-[10px] font-mono text-secondary-700 p-2 border-l border-b border-wireframe bg-surface-light">
              PRJ_{String(index + 1).padStart(3, '0')}
            </div>
            
            <div class="p-6 pb-0">
              <h3 class="text-2xl font-display font-bold text-white mb-2 uppercase group-hover:text-accent transition-colors">
                {project.title}
              </h3>
              <p class="font-mono text-xs text-secondary-500 mb-6 leading-relaxed flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-secondary-700 rounded-full inline-block"></span>
                {project.description}
              </p>
            </div>

            <div class="border-t border-wireframe grayscale group-hover:grayscale-0 transition-all duration-700 relative">
              <div class="absolute inset-0 bg-accent/5 mix-blend-overlay pointer-events-none"></div>
              <img
                src={project.image}
                alt={project.title}
                loading="lazy"
                class="w-full h-56 object-cover object-top border-b border-wireframe"
              />
            </div>

            <div class="p-6 bg-[#121214]">
              <div class="font-mono text-[10px] uppercase text-secondary-600 mb-4 tracking-widest border-b border-wireframe pb-2">
                Tech Stack
              </div>
              <div class="flex flex-wrap gap-2 mb-8">
                {project.technologies.map((tech) => (
                  <span class="font-mono text-[10px] text-white bg-surface border border-secondary-700 px-2 py-1">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex gap-4 font-mono text-xs uppercase tracking-widest">
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 text-secondary-400 hover:text-white transition-colors"
                  >
                    <Icon name="fa6-brands:github" class="w-4 h-4" />
                    [CODE]
                  </a>
                )}
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 text-accent hover:text-white transition-colors"
                  >
                    <Icon name="fa6-solid:up-right-from-square" class="w-3 h-3" />
                    [LIVE]
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-16 flex justify-center">
      <a
        href="https://github.com/hectorrosario22"
        target="_blank"
        rel="noopener noreferrer"
        class="border border-wireframe bg-surface px-8 py-4 font-mono text-sm uppercase tracking-widest text-secondary-400 hover:text-white hover:border-accent transition-colors flex items-center gap-3"
      >
        <Icon name="fa6-brands:github" class="w-4 h-4" />
        {t("projects.viewGitHub")}
        <span class="text-accent">>_</span>
      </a>
    </div>
  </div>
</section>
